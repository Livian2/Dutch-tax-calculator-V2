{
  // Cloudflare Workers deployment (Workers Builds: `npx wrangler deploy`).
  // Serves the Vite build as static assets with SPA fallback, and routes
  // /api/* to the Worker for the Yahoo Finance proxy.
  "name": "dutch-tax-calculator-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
